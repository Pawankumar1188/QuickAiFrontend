# Database Configuration
# Add your PostgreSQL/Neon database connection URL here.
# Example:
# DATABASE_URL=postgresql://username:password@host/database
DATABASE_URL=

# ============================================
# Clerk Authentication
# Get these keys from your Clerk Dashboard.
# Publishable Key is safe for frontend.
CLERK_PUBLISHABLE_KEY=

# Secret Key must NEVER be exposed to the client.
# Keep it only in your backend/server.
CLERK_SECRET_KEY=

# ============================================
# Google Gemini AI
# Generate an API key from Google AI Studio.
# Used for AI chat, text generation, etc.
GEMINI_API_KEY=

# ============================================
# Clipdrop API
# Used for image generation, background removal,
# image upscaling, and other AI image features.
CLIPDROP_API_KEY=

# ============================================
# Cloudinary Configuration
# Used for storing and serving uploaded images/videos.

# Your Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=

# Your Cloudinary API key.
CLOUDINARY_API_KEY=

# Your Cloudinary API secret.
# Never expose this to the frontend.
CLOUDINARY_API_SECRET=



//add your all api
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GEMINI_API_KEY=

CLIPDROP_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ============================================
# Notes:
# 1. Replace each empty value with your own credentials.
# 2. Never commit this file to GitHub.
# 3. Add ".env" to your .gitignore file.
# 4. Restart your development server after updating values.
# 5. Keep all secret keys on the server only.
# ============================================
